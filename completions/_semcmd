#compdef semcmd

_semcmd() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    # Before the command: only help, version and the commands
    _arguments -C \
        '(- : *)'{-h,--help}'[Display help and exit]' \
        '(- : *)'{-V,--version}'[Display version and exit]' \
        '1:command:->command' \
        '*::argument:->argument'

    case $state in
        command)
            local -a commands
            commands=(
                'create:Create a new lock'
                'lock:Acquire a lock'
                'unlock:Release a lock'
                'destroy:Delete a lock'
                'infos:Display lock status'
                'list:List all your locks'
                'clean:Destroy all your locks'
            )
            _describe 'semcmd commands' commands
            ;;
        argument)
            # After the command: its own options and lock names
            curcontext="${curcontext%:*:*}:semcmd-$words[1]:"
            case $words[1] in
                create)
                    # A new lock: existing names are not proposed
                    _arguments \
                        '(-l --locked)'{-l,--locked}'[Create lock in LOCKED state]' \
                        '1:new lock name:'
                    ;;
                destroy)
                    _arguments \
                        '(-f --force)'{-f,--force}'[Force destruction of lock if in use]' \
                        '1:lock:_semcmd_locks'
                    ;;
                clean)
                    _arguments \
                        '(-f --force)'{-f,--force}'[Force destruction of locks in use]'
                    ;;
                lock|unlock|infos)
                    _arguments '1:lock:_semcmd_locks'
                    ;;
            esac
            ;;
    esac
}

_semcmd_locks() {
    local -a locks
    locks=(${(f)"$(semcmd list 2>/dev/null | grep -oP '^\W*- \K[\w-]+(?= )')"})
    _describe 'locks' locks
}

_semcmd "$@"
