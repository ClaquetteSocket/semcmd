#compdef semcmd

_semcmd() {
    local context state line
    typeset -A opt_args

    _arguments \
        '(-h --help)'{-h,--help}'[Display help and exit]' \
        '(-V --version)'{-V,--version}'[Display version and exit]' \
        '(-f --force)'{-f,--force}'[Force destruction of lock if in use]' \
        '(-l --locked)'{-l,--locked}'[Create lock in LOCKED state]' \
        '*::semcmd command:_semcmd_command'
}

_semcmd_command() {
    local -a commands
    commands=(
        'create:Create a new lock'
        'lock:Acquire a lock'
        'unlock:Release a lock'
        'destroy:Delete a lock'
        'infos:Display lock status'
        'list:List all your locks'
        'clean:Destroy all your locks'
    )
    
    if (( CURRENT == 1 )); then
        _describe 'semcmd commands' commands
    elif (( CURRENT == 2 )); then
        case "$words[1]" in
            create|lock|unlock|destroy|infos)
                _semcmd_locks
                ;;
        esac
    fi
}

_semcmd_locks() {
    local -a locks
    locks=(${(f)"$(semcmd list 2>/dev/null | grep -oP '^\W*- \K\w+(?= )')"})
    _describe 'locks' locks
}

_semcmd "$@"